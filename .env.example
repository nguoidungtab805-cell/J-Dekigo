# Copy this file to .env.local or set these vars in your deployment environment
# Cloudinary (legacy media and optional image migration only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional folder inside your Cloudinary account where images will be stored
CLOUDINARY_FOLDER=web-learn-japan

# Cloudflare R2 (required for all new image/video uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public custom domain or r2.dev URL, without the object key
R2_PUBLIC_BASE_URL=
# R2_PUBLIC_URL is also accepted as an alias for R2_PUBLIC_BASE_URL.
# Folder prefix and maximum server upload size (15 MiB by default)
R2_UPLOAD_PREFIX=web-learn-japan/uploads
R2_MAX_UPLOAD_BYTES=15728640
R2_MAX_AUDIO_UPLOAD_BYTES=52428800
# Optional migration settings
R2_MIGRATION_PREFIX=jdeki-go/cloudinary-migration
R2_MIGRATION_CONCURRENCY=3
R2_MIGRATION_MAX_BYTES=104857600
# Optional comma-separated Cloudinary custom delivery hostnames
CLOUDINARY_DELIVERY_HOSTS=

# MongoDB (used by the server)
MONGODB_URI=

# Authentication secrets (use two different random values of at least 32 bytes)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# API base url for client-side (optional)
NEXT_PUBLIC_API_URL=

# Next.js runtime
NODE_ENV=development
